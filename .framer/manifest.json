{
  "files": {
    ".config/nextest.toml": {
      "kind": "managed"
    },
    ".github/dependabot.yml": {
      "kind": "managed"
    },
    ".github/workflows/ci.yml": {
      "kind": "managed"
    },
    ".github/workflows/release-plz.yml": {
      "kind": "managed"
    },
    ".gitignore": {
      "kind": "blocks",
      "ids": [
        "framer",
        "rust-monorepo"
      ]
    },
    "AGENTS.md": {
      "kind": "blocks",
      "ids": [
        "rust-monorepo/conventions"
      ]
    },
    "Cargo.toml": {
      "kind": "toml",
      "keys": [
        "workspace.resolver",
        "workspace.members",
        "workspace.package.edition",
        "workspace.package.license",
        "workspace.package.repository",
        "workspace.package.rust-version",
        "workspace.lints",
        "profile.dev"
      ]
    },
    "clippy.toml": {
      "kind": "managed"
    },
    "mise.toml": {
      "kind": "toml",
      "keys": [
        "tools",
        "tasks.check",
        "tasks.test",
        "tasks.test-ci",
        "tasks.lint",
        "tasks.fmt",
        "tasks.fmt-check",
        "tasks.doc-check",
        "tasks.framer",
        "tasks.framer-check",
        "min_version",
        "settings.lockfile_platforms",
        "tool_config.locked",
        "tasks.tools-check.description",
        "tasks.tools-check.run"
      ]
    },
    "release-plz.toml": {
      "kind": "toml",
      "keys": [
        "workspace.release_always",
        "workspace.git_release_enable",
        "workspace.git_tag_name",
        "workspace.pr_branch_prefix",
        "workspace.pr_name",
        "workspace.dependencies_update"
      ]
    },
    "rust-toolchain.toml": {
      "kind": "managed"
    },
    "rustfmt.toml": {
      "kind": "managed"
    }
  }
}
